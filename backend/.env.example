# --- Claude / 兼容端点 ---
# 官方 Claude 用 ANTHROPIC_API_KEY;第三方兼容端点通常用 AUTH_TOKEN + BASE_URL
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
# 模型:按优先级 ANTHROPIC_MODEL > ANTHROPIC_DEFAULT_SONNET_MODEL > ANTHROPIC_DEFAULT_OPUS_MODEL > CLAUDE_MODEL
CLAUDE_MODEL=claude-opus-5
ANTHROPIC_MODEL=
# 兼容 ANTHROPIC_DEFAULT_{HAIKU,SONNET,OPUS}_MODEL 命名(第三方端点可统一指向同一模型)
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
CLAUDE_MAX_TOKENS=16000

# --- 数据库 ---
DATABASE_URL=sqlite:///./plm.db

# --- 认证(首次启动初始化管理员) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-secret

# --- CORS(前端来源) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- 定时检查(0 = 关闭,仅手动;>0 表示每 N 分钟轮询一次所有启用的仓库) ---
POLL_INTERVAL_MINUTES=0

# --- 评审引擎 ---
# ocr = 调用 Alibaba open-code-review 的 `ocr` CLI(需先 npm i -g @alibaba-group/open-code-review
#       并用 `ocr config` 配好模型;`ocr llm test` 可验证)。ocr 不可用时自动回退内置引擎。
# builtin = 内置 diff→模型 引擎(用上面的 ANTHROPIC_* 配置)。
REVIEW_ENGINE=ocr
OCR_BIN=ocr
OCR_TIMEOUT_MINUTES=15

# --- 静态检查(ESLint) ---
# 平台自带一套 ESLint 对本次提交改动的 JS/TS 文件做静态检查(需先在
# backend/eslint-runner 目录执行 `npm install`,且系统有 Node 18+)。
# NODE_BIN:node 可执行文件路径或命令名;留空默认 "node"。系统若装了旧版 Node
#          (如 v14,ESLint 9 无法运行),会自动跳过并尝试其它 Node,或在此显式指定。
NODE_BIN=node
